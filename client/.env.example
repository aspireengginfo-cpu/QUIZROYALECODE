# ==========================================
# Frontend (Client) Environment Variables
# ==========================================
# If deploying frontend separately (e.g., Netlify / Vercel), set this to your backend URL:
# Example: https://quiz-royale-backend.onrender.com
# For local development with Vite dev server proxying, you can leave it blank or set:
VITE_SERVER_URL=http://localhost:4000
