# ==============================================================================
# QUIZ ROYALE — PRODUCTION & LOCAL ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND / CLIENT (Netlify / Vercel Dashboard Environment Variables)
# ------------------------------------------------------------------------------
# Point this to your live deployed backend service:
# Example: https://quiz-royale-backend.onrender.com
# (Leave blank or set to http://localhost:4000 for local development)
VITE_SERVER_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# 2. BACKEND / SERVER (Render / Railway / Fly.io Dashboard Environment Variables)
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=production

# The URL of your deployed frontend (for CORS security).
# Can be your Netlify/Vercel domain or "*" to allow any origin:
# Example: https://quiz-royale.netlify.app
CLIENT_URL=*

# (Optional) MongoDB Atlas Connection String
# If left empty, the server automatically uses the built-in 105+ questions 
# and local file persistence for game history without crashing.
MONGODB_URI=
