# ==========================================
# Backend (Server) Environment Variables
# ==========================================
PORT=4000
NODE_ENV=development

# Allowed frontend origin for CORS (comma-separated if multiple, or * to allow all)
# Example: https://quiz-royale.netlify.app,https://myquiz.vercel.app
CLIENT_URL=http://localhost:5173

# Database Configuration (Optional for development; uses built-in questions & fallback file if empty)
# In production, set your MongoDB Atlas connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/quiz_royale?retryWrites=true&w=majority
MONGODB_URI=
